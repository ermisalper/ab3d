MESHY_API_KEY=
OPENAI_API_KEY=
OPENAI_DESIGN_AGENT_MODEL=gpt-5.6-luna
AB3D_UNLIMITED_EMAILS=
AB3D_OWNER_EMAILS=

# CAPPATEX: all three switches default to disabled. Enable only after owner approval.
CAPPATEX_GENERATION_ENABLED=false
CAPPATEX_FULFILLMENT_ENABLED=false
CAPPATEX_AUTO_PRODUCTION_ENABLED=false

# Printify private API token and the connected Printify shop ID.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Shopify is the checkout backend; this website remains the visible storefront.
SHOPIFY_STORE_DOMAIN=1hagfh-b0.myshopify.com
# Automatic collections used by the storefront:
# AB3D 3D-Produkte (vendor AB3D) -> ab3d-3d-produkte
# CAPPATEX (vendor Printify) -> cappatex
# Optional: products and carts can use tokenless Storefront API access. If a token is set, keep it server-side.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
